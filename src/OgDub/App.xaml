<Application x:Class="OgDub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Color x:Key="Shell">#1A1410</Color>
        <Color x:Key="ShellHi">#3A2A22</Color>
        <Color x:Key="Amber">#FFB000</Color>
        <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource Shell}" />
        <SolidColorBrush x:Key="ShellHiBrush" Color="{StaticResource ShellHi}" />
        <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}" />
        <SolidColorBrush x:Key="LcdBg" Color="#0B1A12" />
        <SolidColorBrush x:Key="LcdText" Color="#7CFF6B" />
        <SolidColorBrush x:Key="RecRed" Color="#C41E3A" />
        <SolidColorBrush x:Key="KeyCap" Color="#2A211C" />
        <SolidColorBrush x:Key="KeyText" Color="#F3E6D8" />
        <Style TargetType="Button" x:Key="DeckKey">
            <Setter Property="Foreground" Value="{StaticResource KeyText}" />
            <Setter Property="Background" Value="{StaticResource KeyCap}" />
            <Setter Property="BorderBrush" Value="#5A463C" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
