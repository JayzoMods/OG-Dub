<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>OgDub</RootNamespace>
    <AssemblyName>OgDub</AssemblyName>
    <Product>OG Dub</Product>
    <Company>OG Digital Designs</Company>
    <Authors>OG Digital Designs</Authors>
    <Description>Desk boombox that aims at one Windows app and records it to a cassette crate. Not a stream ripper.</Description>
    <Version>0.9.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OgDub.Core\OgDub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Legal\TermsOfUse.txt" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\og-dub-mark.png" />
    <Resource Include="Assets\og-dub-favicon.png" />
    <Resource Include="Assets\og-dub-logo.png" />
  </ItemGroup>

</Project>
