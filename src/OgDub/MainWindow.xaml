<Window x:Class="OgDub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OG Dub"
        Width="460"
        Height="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Topmost="{Binding AlwaysOnTop}"
        MouseLeftButtonDown="Chrome_OnMouseDown">
    <Border CornerRadius="22" BorderThickness="4" BorderBrush="#5A3D2E" Background="#221810" Padding="12">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                <TextBlock Text="OG DUB" FontWeight="Black" FontSize="14" Foreground="{StaticResource AmberBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Top" Foreground="{StaticResource KeyText}"
                              IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{StaticResource DeckKey}" Content="Terms" MinWidth="48" Command="{Binding TermsCommand}" />
                    <Button Style="{StaticResource DeckKey}" Content="×" MinWidth="36" Click="Close_OnClick" />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Margin="4,8,4,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="#C9B8A8" Text="{Binding Status}" />

            <Border DockPanel.Dock="Bottom" Margin="4,10,4,0" Background="#140F0C" CornerRadius="8" Padding="8" Height="168">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CRATE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource AmberBrush}" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Cassettes}" SelectedItem="{Binding SelectedCassette}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource KeyText}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                                        BorderThickness="2" BorderBrush="#111"
                                        Background="{Binding ShellColour}">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1A120C"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Background="#2A1C16" CornerRadius="14" Padding="10" BorderBrush="#4A3228" BorderThickness="2">
                <StackPanel>
                    <Border Background="{StaticResource LcdBg}" CornerRadius="6" Padding="10" Height="88">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding LcdMode}" Foreground="{StaticResource LcdText}"
                                       FontFamily="Consolas" FontSize="11" />
                            <TextBlock Grid.Row="1" Text="{Binding LcdLine}" Foreground="{StaticResource LcdText}"
                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="{Binding LcdTime}" Foreground="{StaticResource LcdText}"
                                           FontFamily="Consolas" FontSize="14" />
                                <Ellipse Width="10" Height="10" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Fill="{StaticResource RecRed}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Opacity" Value="0.25" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecLit}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,10,0,0" Height="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Vu}"
                                     Height="12" Foreground="{StaticResource AmberBrush}" Background="#1A120E" BorderThickness="0" />
                        <ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding TapePack}"
                                     Height="12" Foreground="#6B4423" Background="#1A120E" BorderThickness="0" />
                    </Grid>

                    <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Stations}"
                              SelectedItem="{Binding SelectedStation}"
                              DisplayMemberPath="Label" />

                    <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Button Style="{StaticResource DeckKey}" Content="SCAN" Command="{Binding ScanCommand}" />
                        <Button Style="{StaticResource DeckKey}" Content="REC" Background="#6B1E1E"
                                Command="{Binding RecCommand}" />
                        <Button Style="{StaticResource DeckKey}" Content="STOP" Command="{Binding StopCommand}" />
                        <Button Style="{StaticResource DeckKey}" Content="PLAY" Command="{Binding PlayCommand}" />
                        <Button Style="{StaticResource DeckKey}" Content="DUB" Command="{Binding DubCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
