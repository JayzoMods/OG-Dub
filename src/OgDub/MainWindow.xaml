<Window x:Class="OgDub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OG Dub"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="580"
        Height="780"
        MinWidth="520"
        MinHeight="760"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#01000000"
        AllowsTransparency="True"
        Topmost="{Binding AlwaysOnTop}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseMove="Window_OnPreviewMouseMove"
        PreviewMouseLeftButtonDown="Window_OnPreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_OnPreviewMouseLeftButtonUp"
        LostMouseCapture="Window_OnLostMouseCapture"
        MouseLeftButtonDown="Chrome_OnMouseDown">
    <Window.InputBindings>
        <KeyBinding Key="R" Command="{Binding RecCommand}" />
        <KeyBinding Key="K" Command="{Binding KeepCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="P" Command="{Binding PlayCommand}" />
    </Window.InputBindings>
    <Border x:Name="ChromeBorder" CornerRadius="22" BorderThickness="5" BorderBrush="#7A5A48" Padding="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A1A14" Offset="0" />
                <GradientStop Color="#16100C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="ChromeGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="8" />
                <RowDefinition x:Name="CrateRow" Height="180" MinHeight="96" MaxHeight="480" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand row + options row so chrome never stacks on the title when narrow -->
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/og-dub-mark.png" Width="26" Height="26"
                               Margin="0,0,8,0" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="OG DUB" FontWeight="Black" FontSize="16"
                                   Foreground="{StaticResource AmberBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DeckKey}" Content="How to" MinWidth="56" Click="HowTo_OnClick" />
                        <Button Style="{StaticResource DeckKey}" Content="Terms" MinWidth="48" Click="Terms_OnClick" />
                        <Button x:Name="MinimizeButton" Style="{StaticResource DeckKey}" Content="–" MinWidth="36"
                                Click="Minimize_OnClick" ToolTip="Minimise" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource DeckKey}" Content="□" MinWidth="36"
                                Click="Maximize_OnClick" ToolTip="Maximise" />
                        <Button Style="{StaticResource DeckKey}" Content="×" MinWidth="36" Click="Close_OnClick" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox Style="{StaticResource DeckCheck}" Content="Top"
                              IsChecked="{Binding AlwaysOnTop}" Margin="0,0,10,0" />
                    <CheckBox x:Name="PerSongCheck" Style="{StaticResource DeckCheck}" Content="Per song"
                              IsChecked="{Binding SplitOnSong}" Margin="0,0,10,0"
                              ToolTip="While Rec is on, a new Windows now-playing title ejects and starts a fresh cassette." />
                    <CheckBox Style="{StaticResource DeckCheck}" Content="Hotkeys"
                              IsChecked="{Binding GlobalHotkeys}"
                              ToolTip="Ctrl+Alt+R Rec. Ctrl+Alt+S Stop. Works while this boombox is open." />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                    <Ellipse Width="36" Height="36" Fill="#120C09" Stroke="#4A3228" StrokeThickness="2" Margin="0,4" />
                    <Ellipse Width="28" Height="28" Fill="#0C0806" Stroke="#3A2820" StrokeThickness="1" Margin="0,6" />
                    <Ellipse Width="36" Height="36" Fill="#120C09" Stroke="#4A3228" StrokeThickness="2" Margin="0,4" />
                    <Ellipse Width="22" Height="22" Fill="#0C0806" Stroke="#3A2820" StrokeThickness="1" Margin="0,6" />
                    <Ellipse Width="36" Height="36" Fill="#120C09" Stroke="#4A3228" StrokeThickness="2" Margin="0,4" />
                </StackPanel>

                <Border Grid.Column="1" Background="#241814" CornerRadius="14" Padding="10"
                        BorderBrush="#6A5044" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" Color="#000" />
                    </Border.Effect>
                    <StackPanel>
                        <Border x:Name="LcdPanel" Background="{StaticResource LcdBg}" CornerRadius="6" Padding="10" Height="92"
                                BorderBrush="#1C3A28" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.RowSpan="3" Fill="#14FFFFFF" Height="1" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False" />
                                <Rectangle Grid.RowSpan="3" Fill="#10FFFFFF" Height="1" VerticalAlignment="Top" Margin="0,18,0,0" IsHitTestVisible="False" />
                                <TextBlock Grid.Row="0" Text="{Binding LcdMode}" Foreground="{StaticResource LcdText}"
                                           FontFamily="Consolas" FontSize="11" />
                                <TextBlock Grid.Row="1" Text="{Binding LcdLine}" Foreground="{StaticResource LcdText}"
                                           FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding LcdTime}" Foreground="{StaticResource LcdText}"
                                               FontFamily="Consolas" FontSize="14" />
                                    <TextBlock Text="  " Foreground="{StaticResource LcdText}"
                                               FontFamily="Consolas" FontSize="14" />
                                    <TextBlock Text="{Binding LcdCounter}" Foreground="{StaticResource LcdText}"
                                               FontFamily="Consolas" FontSize="14" />
                                    <Ellipse x:Name="RecLamp" Width="11" Height="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                             Fill="{StaticResource RecRed}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Opacity" Value="0.22" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecLit}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="RecPulseBoard">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1" To="0.32" Duration="0:0:0.42"
                                                                                     AutoReverse="True" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="RecPulseBoard" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse x:Name="ClipLamp" Width="11" Height="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                             Fill="{StaticResource ClipAmber}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Opacity" Value="0.22" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClipLit}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="ClipFlashBoard">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.35" To="1" Duration="0:0:0.12"
                                                                                     AutoReverse="True" RepeatBehavior="3x" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="ClipFlashBoard" />
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,10,0,0" Height="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Style="{StaticResource VuBar}" Minimum="0" Maximum="1" Value="{Binding Vu}" />
                            <ProgressBar Grid.Column="2" Style="{StaticResource VuBar}" Minimum="0" Maximum="1" Value="{Binding TapePack}"
                                         Foreground="#8A5A32" />
                        </Grid>

                        <ComboBox x:Name="StationCombo" Style="{StaticResource DeckComboBox}" Margin="0,10,0,0"
                                  ItemsSource="{Binding Stations}"
                                  SelectedItem="{Binding SelectedStation}"
                                  DisplayMemberPath="Label"
                                  DropDownOpened="Stations_OnDropDownOpened"
                                  DropDownClosed="Stations_OnDropDownClosed" />
                        <CheckBox x:Name="MicCheck" Style="{StaticResource DeckCheck}" Margin="0,8,0,0" Content="Mic (Side B)"
                                  IsChecked="{Binding RecordMic}"
                                  ToolTip="Records the default microphone onto Side B. Not mixed into the app tape. 32-bit float with a −12 dB pad." />
                        <ComboBox x:Name="PlayToCombo" Style="{StaticResource DeckComboBox}" Margin="0,8,0,0"
                                  ItemsSource="{Binding RenderDevices}"
                                  SelectedItem="{Binding SelectedRenderDevice}"
                                  DisplayMemberPath="Label"
                                  ToolTip="Where Play and Flip send the cassette. Windows default follows the system playback device." />

                        <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Button x:Name="ScanButton" Style="{StaticResource DeckKey}" Content="SCAN" Command="{Binding ScanCommand}" />
                            <Button x:Name="RecButton" Style="{StaticResource DeckKey}" Content="REC" Background="#8B1E24"
                                    Command="{Binding RecCommand}" />
                            <Button x:Name="KeepButton" Style="{StaticResource DeckKey}" Content="KEEP" Command="{Binding KeepCommand}" />
                            <Button x:Name="StopButton" Style="{StaticResource DeckKey}" Content="STOP" Command="{Binding StopCommand}" />
                            <Button x:Name="PlayButton" Style="{StaticResource DeckKey}" Content="PLAY" Background="{StaticResource PlayGreen}"
                                    Command="{Binding PlayCommand}" />
                            <Button x:Name="FlipButton" Style="{StaticResource DeckKey}" Content="FLIP" Command="{Binding FlipCommand}" />
                            <Button x:Name="MarkButton" Style="{StaticResource DeckKey}" Content="MARK" Command="{Binding MarkCommand}" />
                            <Button x:Name="CueButton" Style="{StaticResource DeckKey}" Content="CUE" Command="{Binding CueCommand}" />
                            <Button x:Name="DubButton" Style="{StaticResource DeckKey}" Content="DUB" Command="{Binding DubCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                    <Ellipse Width="36" Height="36" Fill="#120C09" Stroke="#4A3228" StrokeThickness="2" Margin="0,4" />
                    <Ellipse Width="28" Height="28" Fill="#0C0806" Stroke="#3A2820" StrokeThickness="1" Margin="0,6" />
                    <Ellipse Width="36" Height="36" Fill="#120C09" Stroke="#4A3228" StrokeThickness="2" Margin="0,4" />
                    <Ellipse Width="22" Height="22" Fill="#0C0806" Stroke="#3A2820" StrokeThickness="1" Margin="0,6" />
                    <Ellipse Width="36" Height="36" Fill="#120C09" Stroke="#4A3228" StrokeThickness="2" Margin="0,4" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Row="2"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#4A3228"
                          ShowsPreview="False"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS" />

            <Border Grid.Row="3" Margin="4,0,4,0" Background="#100C0A" CornerRadius="8" Padding="8"
                    BorderBrush="#3A2A22" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CrateLabel" Grid.Column="0" Text="CRATE" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AmberBrush}"
                                   Cursor="Hand" ToolTip="Open crate folder"
                                   MouseLeftButtonDown="CrateLabel_OnMouseDown"
                                   MouseLeftButtonUp="CrateLabel_OnClick" />
                        <TextBlock x:Name="FavLabel" Grid.Column="2" Text="FAV" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AmberBrush}" Margin="12,0,0,0"
                                   Cursor="Hand" ToolTip="Open Favorites folder"
                                   MouseLeftButtonDown="CrateLabel_OnMouseDown"
                                   MouseLeftButtonUp="FavLabel_OnClick" />
                        <TextBlock x:Name="FolderLabel" Grid.Column="3" Text="FOLDER" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AmberBrush}" Margin="12,0,0,0"
                                   Cursor="Hand" ToolTip="Choose crate folder"
                                   MouseLeftButtonDown="CrateLabel_OnMouseDown"
                                   MouseLeftButtonUp="FolderLabel_OnClick" />
                    </Grid>
                    <ListBox x:Name="CrateList" ItemsSource="{Binding Cassettes}" SelectedItem="{Binding SelectedCassette}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource KeyText}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="CrateList_OnMouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Sel"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="6"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Sel" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Sel" Property="Background" Value="#18FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="8,6"
                                        BorderThickness="2" BorderBrush="#1A0E08"
                                        Background="{Binding ShellColour}"
                                        MinHeight="78"
                                        PreviewMouseLeftButtonDown="Cassette_OnPreviewMouseLeftButtonDown"
                                        MouseMove="Cassette_OnMouseMove">
                                    <Grid>
                                        <Ellipse Width="10" Height="10" Fill="#22000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" />
                                        <Ellipse Width="10" Height="10" Fill="#22000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" />
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Button Content="Aa" ToolTip="Rename J-card"
                                                        Padding="6,2" Margin="0,0,6,0" MinWidth="28"
                                                        FontSize="11" FontWeight="Bold"
                                                        Foreground="#1A120C" Background="#33FFFFFF" BorderThickness="0"
                                                        Command="{Binding DataContext.RenameCassetteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{Binding FavoriteGlyph}"
                                                        ToolTip="Favourite / unfavourite"
                                                        Padding="6,2" Margin="0,0,6,0" MinWidth="28"
                                                        FontSize="14" FontWeight="Bold"
                                                        Foreground="#1A120C" Background="#33FFFFFF" BorderThickness="0"
                                                        Visibility="{Binding CanFavorite, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.FavoriteCassetteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#x1F5D1;" ToolTip="Delete"
                                                        Padding="6,2" MinWidth="28"
                                                        FontSize="12"
                                                        Foreground="#1A120C" Background="#33FFFFFF" BorderThickness="0"
                                                        Command="{Binding DataContext.DeleteCassetteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <Image DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,8,0"
                                                   Stretch="UniformToFill"
                                                   Source="{Binding Artwork}"
                                                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="B" FontWeight="Black" FontSize="12"
                                                       Foreground="#1A120C" VerticalAlignment="Top" Margin="8,0,0,0"
                                                       Visibility="{Binding HasSideB, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1A120C"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LoudnessLabel}" FontSize="10" Foreground="#1A120C"
                                                           Visibility="{Binding HasLoudness, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding MarkerLabel}" FontSize="10" Foreground="#1A120C"
                                                           Visibility="{Binding HasMarkers, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="4" Margin="4,8,4,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="#C9B8A8" Text="{Binding Status}" />

            <Grid x:Name="HowToOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed">
                <Path x:Name="HowToDimmer" Fill="#CC0A0706" Stretch="None" />
                <Canvas>
                    <Border x:Name="HowToSpot" BorderBrush="{StaticResource AmberBrush}" BorderThickness="3"
                            CornerRadius="8" Background="Transparent" IsHitTestVisible="False" />
                </Canvas>
                <Border x:Name="HowToCard" VerticalAlignment="Bottom" Margin="16,0,16,16"
                        Background="#221810" BorderBrush="{StaticResource AmberBrush}" BorderThickness="2"
                        CornerRadius="10" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <TextBlock x:Name="HowToIndex" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="#C9B8A8" FontFamily="Consolas" FontSize="12" />
                            <Button Style="{StaticResource DeckKey}" Content="Back" Click="HowToBack_OnClick" />
                            <Button Style="{StaticResource DeckKey}" Content="Next" Click="HowToNext_OnClick" />
                            <Button Style="{StaticResource DeckKey}" Content="Done" Background="#6B1E1E" Click="HowToDone_OnClick" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="HowToTitle" FontWeight="Black" FontSize="16"
                                       Foreground="{StaticResource AmberBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="HowToBody" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{StaticResource KeyText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
