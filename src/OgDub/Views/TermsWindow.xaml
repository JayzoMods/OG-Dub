<Window x:Class="OgDub.Views.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terms and conditions — OG Dub"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBrush}"
        Foreground="{StaticResource KeyText}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"
                   Text="Terms and conditions" Foreground="{StaticResource AmberBrush}" />
        <ScrollViewer Grid.Row="1" Margin="0,0,0,12" VerticalScrollBarVisibility="Auto">
            <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource KeyText}" Text="{Binding TermsText}" />
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="#C9B8A8"
                   Text="Your rights under the Australian Consumer Law cannot be excluded. These terms limit other liability only where the law allows." />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource DeckKey}" Content="Decline and exit"
                    Visibility="{Binding ShowDecline, Converter={StaticResource BoolToVis}}" Click="Decline_OnClick" />
            <Button Style="{StaticResource DeckKey}" Content="Accept" Background="#6B1E1E"
                    Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVis}}" Click="Accept_OnClick" />
            <Button Style="{StaticResource DeckKey}" Content="Close"
                    Visibility="{Binding ShowClose, Converter={StaticResource BoolToVis}}" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
