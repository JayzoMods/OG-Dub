<Window x:Class="OgDub.Views.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename cassette"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ShellBrush}"
        Foreground="{StaticResource KeyText}">
    <StackPanel Margin="16" Width="340">
        <TextBlock Text="J-card title" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" FontSize="14" Padding="8,6" KeyDown="NameBox_OnKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource DeckKey}" Content="Cancel" Click="Cancel_OnClick" />
            <Button Style="{StaticResource DeckKey}" Content="Save" Background="#6B1E1E" Click="Ok_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
